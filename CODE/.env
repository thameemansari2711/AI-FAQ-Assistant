# Rename this file to .env and fill in your real values

PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/ai-faq-assistant
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-faq-assistant
MONGO_URI=your mongo_uri

# Secret key used to sign JWT login tokens (use any long random string)
JWT_SECRET=your jwt secret

# Google Gemini API key - get one free at https://aistudio.google.com
GEMINI_API_KEY=your GEMINI_API_KEY
